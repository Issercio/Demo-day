# Copy this file to Demoday/.env and replace the placeholders.
# Never commit a real .env file.

# Local SQLite file created under Demoday/
DATABASE_URL=sqlite:///florashop.db

# Production-style PostgreSQL (optional)
# DATABASE_URL=postgresql://florashop:change-me-db-password@localhost:5432/florashop
DB_NAME=florashop
DB_USER=florashop
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

# Flask / JWT signing key (use a long random string in production)
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Stripe (optional). Leave empty to use the built-in test card processor.
# 4242 4242 4242 4242 = success
# 4000 0000 0000 0002 = declined
# 4000 0000 0000 9995 = insufficient funds
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TLS. HTTP: ./run.sh. HTTPS local : ./run-https.sh (certificat auto-signé).
# Derrière nginx, FORCE_HTTPS=1 redirige HTTP (X-Forwarded-Proto).
FLASK_HTTPS=0
FORCE_HTTPS=0
# SSL_CERT_FILE=
# SSL_KEY_FILE=

# SMTP optionnel pour les codes de vérification / reset. Vide = demo_code dans le JSON.
# MAIL_SERVER=
# MAIL_PORT=25
# MAIL_FROM=noreply@localhost
