# Copy this file to Demoday/.env and replace the placeholders.
# Never commit a real .env file. ./setup.sh copies this file and generates SECRET_KEY.

# Local SQLite file created under Demoday/
DATABASE_URL=sqlite:///florashop.db

# Production-style PostgreSQL (optional)
# DATABASE_URL=postgresql://florashop:change-me-db-password@localhost:5432/florashop
DB_NAME=florashop
DB_USER=florashop
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

# Flask / JWT signing key — setup.sh remplace les placeholders par openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Stripe (optionnel). Vide = processeur de cartes de test (PAN 4242…, pas Stripe.js).
# Clés Dashboard : pk_test_ / sk_test_ (ou live). Ne jamais coller d’exemple inventé.
# Webhook : https://VOTRE_DOMAINE/api/v1/payments/webhook  (événement payment_intent.*)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TLS. HTTP: ./run.sh. HTTPS local : ./run-https.sh (certificat auto-signé).
# En prod (Render / nginx), FORCE_HTTPS=1 redirige HTTP (X-Forwarded-Proto).
# Stripe.js en live exige un HTTPS public.
FLASK_HTTPS=0
FORCE_HTTPS=0
# SSL_CERT_FILE=
# SSL_KEY_FILE=

# SMTP réel pour commandes / contact / réponses. Vide = journalisé, le paiement continue.
# 587 + MAIL_STARTTLS=1 (recommandé)  ou  465 + MAIL_SSL=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_STARTTLS=1
MAIL_SSL=0
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_TO=

# PayPal (optionnel). Vide = bouton sandbox local, sans API PayPal.
# CLIENT_ID Dashboard (public) + SECRET. PAYPAL_MODE=sandbox ou live.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox

# SMS Twilio (optionnel). Vide = code journalisé, comme MAIL_*.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
