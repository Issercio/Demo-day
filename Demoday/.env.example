# Copy to Demoday/.env — never commit real secrets.
# ./setup.sh génère SECRET_KEY / JWT_SECRET_KEY (openssl rand -hex 32).

DATABASE_URL=sqlite:///florashop.db
# DATABASE_URL=postgresql://florashop:change-me-db-password@localhost:5432/florashop

DB_NAME=florashop
DB_USER=florashop
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Stripe optionnel. Vide = cartes de test. Live : pk_/sk_ du Dashboard + webhook HTTPS.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP. 587 + MAIL_STARTTLS=1  ou  465 + MAIL_SSL=1
MAIL_SERVER=
MAIL_PORT=587
MAIL_STARTTLS=1
MAIL_SSL=0
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_TO=
