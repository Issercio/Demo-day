{
  "info": {
    "name": "FloraShop API",
    "description": "Demo Day collection: auth, catalog, checkout test cards. Run the Flask app on http://localhost:5000 first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth — login Marie",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"marie@test.com\",\n  \"password\": \"marie123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Auth — login Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@florashop.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Catalog — list products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/products"
      }
    },
    {
      "name": "Catalog — create category (admin JWT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Category\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/categories"
      }
    },
    {
      "name": "Payments — config",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/payments/config"
      }
    },
    {
      "name": "Payments — checkout success 4242",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"marie@test.com\",\n  \"name\": \"Marie Test\",\n  \"payment_method\": \"card\",\n  \"card_number\": \"4242424242424242\",\n  \"card_expiry\": \"12/34\",\n  \"card_cvc\": \"123\",\n  \"items\": [{ \"product_id\": 1, \"quantity\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/api/v1/payments/checkout"
      }
    },
    {
      "name": "Payments — checkout declined 0002",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"marie@test.com\",\n  \"name\": \"Marie Test\",\n  \"payment_method\": \"card\",\n  \"card_number\": \"4000000000000002\",\n  \"card_expiry\": \"12/34\",\n  \"card_cvc\": \"123\",\n  \"items\": [{ \"product_id\": 1, \"quantity\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/api/v1/payments/checkout"
      }
    },
    {
      "name": "Payments — list orders (admin JWT)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/v1/payments/orders"
      }
    }
  ]
}
